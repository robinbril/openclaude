# Copy to ".env" next to the bridge. NEVER commit the real .env (gitignore it).

# --- Seat ---
# Full path to the claude binary. Windows default shown; on macOS/Linux use: claude
CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
CLAUDE_MODEL=sonnet
# Only needed headless / on a VPS (mint once with: claude setup-token).
# On a machine where you're already logged in, leave this empty.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Bridge auth (shared secret between your app and the bridge) ---
SEAT_KEY=
SEAT_PORT=8771

# --- Kapso WhatsApp (kapso.ai free sandbox) ---
KAPSO_API_KEY=
KAPSO_PHONE_ID=
NOTIFY_TO=316XXXXXXXX

# --- Triggers ---
NOTIFY_ENABLED=true
NOTIFY_HOUR=9
ALERTS_ENABLED=true
POLL_MINUTES=10

# Set to the secret_key Kapso RETURNS when you register the webhook (not what you sent).
WEBHOOK_SECRET=
